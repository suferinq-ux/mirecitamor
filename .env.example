# ─────────────────────────────────────────────────────────────
#  NUESTRO UNIVERSO SECRETO · configuración
#  Copia este archivo como `.env.local` y completa los valores.
#  En Vercel: Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Nombres que aparecerán en la portada y en el panel (solo ustedes dos)
NEXT_PUBLIC_NAME_1=Mi Amor
NEXT_PUBLIC_NAME_2=Mi Vida

# Fecha de aniversario (opcional) · formato AAAA-MM-DD
# NEXT_PUBLIC_ANNIVERSARY=2024-02-14

# Contraseñas HASHEADAS (nunca guardes la contraseña real aquí).
# Genera cada una con:  npm run password
PASS_HASH_1=
PASS_HASH_2=

# Secreto para firmar las sesiones (cadena larga y aleatoria).
# Genera una con:  npm run secret
SESSION_SECRET=
